{
  "name": "Tiki Love Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // ── Base UI ──────────────────────────────────────────────
    "foreground": "#E8D5B7",
    "focusBorder": "#D4843E",
    "selection.background": "#D4843E55",
    "descriptionForeground": "#C4A97D",
    "errorForeground": "#E85A4F",
    "icon.foreground": "#D4943E",

    // ── Editor (main writing surface — darkest warm brown) ──
    "editor.background": "#1A1410",
    "editor.foreground": "#E8D5B7",
    "editor.lineHighlightBackground": "#2A2018",
    "editor.selectionBackground": "#D4843E44",
    "editor.selectionHighlightBackground": "#D4843E22",
    "editor.wordHighlightBackground": "#5C8A4A33",
    "editor.wordHighlightStrongBackground": "#5C8A4A55",
    "editor.findMatchBackground": "#D4843E55",
    "editor.findMatchHighlightBackground": "#D4843E33",
    "editor.rangeHighlightBackground": "#2A201844",
    "editorCursor.foreground": "#F0A84C",
    "editorWhitespace.foreground": "#3A2E22",
    "editorIndentGuide.background": "#2E2419",
    "editorIndentGuide.activeBackground": "#4A3A28",
    "editorLineNumber.foreground": "#5A4A35",
    "editorLineNumber.activeForeground": "#D4943E",
    "editorBracketMatch.background": "#D4843E33",
    "editorBracketMatch.border": "#D4843E",
    "editorGutter.background": "#1A1410",
    "editorOverviewRuler.border": "#2E2419",
    "editorRuler.foreground": "#2E2419",
    "editorError.foreground": "#E85A4F",
    "editorWarning.foreground": "#F0A84C",
    "editorInfo.foreground": "#5C9A5A",

    // ── Bracket pair colorization ────────────────────────────
    "editorBracketHighlight.foreground1": "#F0A84C",
    "editorBracketHighlight.foreground2": "#5C9A5A",
    "editorBracketHighlight.foreground3": "#D4843E",
    "editorBracketHighlight.foreground4": "#8AB87A",
    "editorBracketHighlight.foreground5": "#E8C56A",
    "editorBracketHighlight.foreground6": "#C47A3E",

    // ── Primary Sidebar (left — slightly warmer/lighter) ────
    "sideBar.background": "#1E1812",
    "sideBar.foreground": "#D4BE96",
    "sideBar.border": "#2E2419",
    "sideBarTitle.foreground": "#F0A84C",
    "sideBarSectionHeader.background": "#26201A",
    "sideBarSectionHeader.foreground": "#E8C56A",
    "sideBarSectionHeader.border": "#2E2419",

    // ── Secondary Sidebar (right — greenish tint) ───────────
    "sideBarStickyScroll.background": "#181C14",
    "secondarySideBar.background": "#161A12",
    "secondarySideBar.foreground": "#C4D0A8",
    "secondarySideBar.border": "#2A3020",

    // ── Activity Bar (far left icon bar) ────────────────────
    "activityBar.background": "#16120E",
    "activityBar.foreground": "#F0A84C",
    "activityBar.inactiveForeground": "#6A5A42",
    "activityBar.border": "#2E2419",
    "activityBarBadge.background": "#D4843E",
    "activityBarBadge.foreground": "#1A1410",

    // ── Title Bar ───────────────────────────────────────────
    "titleBar.activeBackground": "#16120E",
    "titleBar.activeForeground": "#E8D5B7",
    "titleBar.inactiveBackground": "#16120E",
    "titleBar.inactiveForeground": "#6A5A42",
    "titleBar.border": "#2E2419",

    // ── Tabs ────────────────────────────────────────────────
    "editorGroupHeader.tabsBackground": "#1A1610",
    "editorGroupHeader.tabsBorder": "#2E2419",
    "tab.activeBackground": "#1A1410",
    "tab.activeForeground": "#F0A84C",
    "tab.activeBorderTop": "#D4843E",
    "tab.inactiveBackground": "#1A1610",
    "tab.inactiveForeground": "#7A6A50",
    "tab.border": "#2E2419",
    "tab.hoverBackground": "#26201A",

    // ── Terminal (distinct deep green-brown tint) ───────────
    "terminal.background": "#141810",
    "terminal.foreground": "#D4D0B0",
    "terminal.border": "#2A3020",
    "terminal.ansiBlack": "#1A1E14",
    "terminal.ansiRed": "#E85A4F",
    "terminal.ansiGreen": "#6AAF5C",
    "terminal.ansiYellow": "#F0A84C",
    "terminal.ansiBlue": "#8A9A6A",
    "terminal.ansiMagenta": "#D4843E",
    "terminal.ansiCyan": "#5C9A7A",
    "terminal.ansiWhite": "#E8D5B7",
    "terminal.ansiBrightBlack": "#4A5440",
    "terminal.ansiBrightRed": "#F07A6F",
    "terminal.ansiBrightGreen": "#8ACF7A",
    "terminal.ansiBrightYellow": "#F0C06C",
    "terminal.ansiBrightBlue": "#A0B08A",
    "terminal.ansiBrightMagenta": "#E8A060",
    "terminal.ansiBrightCyan": "#7AB89A",
    "terminal.ansiBrightWhite": "#F4E8D0",
    "terminalCursor.foreground": "#F0A84C",

    // ── Panel (bottom panel — terminal/output area header) ──
    "panel.background": "#141810",
    "panel.border": "#2A3020",
    "panelTitle.activeBorder": "#D4843E",
    "panelTitle.activeForeground": "#F0A84C",
    "panelTitle.inactiveForeground": "#6A7A52",

    // ── Status Bar ──────────────────────────────────────────
    "statusBar.background": "#16120E",
    "statusBar.foreground": "#C4A97D",
    "statusBar.border": "#2E2419",
    "statusBar.debuggingBackground": "#D4843E",
    "statusBar.debuggingForeground": "#1A1410",
    "statusBar.noFolderBackground": "#1E1812",
    "statusBarItem.hoverBackground": "#2E2419",
    "statusBarItem.prominentBackground": "#D4843E",
    "statusBarItem.prominentForeground": "#1A1410",
    "statusBarItem.remoteBackground": "#5C8A4A",
    "statusBarItem.remoteForeground": "#1A1410",

    // ── Input & Dropdowns ───────────────────────────────────
    "input.background": "#221C14",
    "input.foreground": "#E8D5B7",
    "input.border": "#3A2E22",
    "input.placeholderForeground": "#6A5A42",
    "inputOption.activeBorder": "#D4843E",
    "inputOption.activeBackground": "#D4843E33",
    "dropdown.background": "#221C14",
    "dropdown.foreground": "#E8D5B7",
    "dropdown.border": "#3A2E22",

    // ── Buttons ─────────────────────────────────────────────
    "button.background": "#D4843E",
    "button.foreground": "#1A1410",
    "button.hoverBackground": "#E89A4E",
    "button.secondaryBackground": "#3A3020",
    "button.secondaryForeground": "#E8D5B7",
    "button.secondaryHoverBackground": "#4A3E2A",

    // ── Lists (file explorer, command palette, etc.) ────────
    "list.activeSelectionBackground": "#2E2419",
    "list.activeSelectionForeground": "#F0A84C",
    "list.hoverBackground": "#26201A",
    "list.hoverForeground": "#E8D5B7",
    "list.inactiveSelectionBackground": "#26201A",
    "list.inactiveSelectionForeground": "#D4BE96",
    "list.highlightForeground": "#F0A84C",
    "list.focusBackground": "#2E2419",
    "list.focusForeground": "#F0A84C",

    // ── Command palette / Quick input ───────────────────────
    "quickInput.background": "#1E1812",
    "quickInput.foreground": "#E8D5B7",
    "quickInputTitle.background": "#26201A",
    "quickInputList.focusBackground": "#2E2419",

    // ── Peek View ───────────────────────────────────────────
    "peekView.border": "#D4843E",
    "peekViewEditor.background": "#1E1812",
    "peekViewEditorGutter.background": "#1A1610",
    "peekViewResult.background": "#1A1610",
    "peekViewResult.fileForeground": "#F0A84C",
    "peekViewResult.selectionBackground": "#D4843E44",
    "peekViewTitle.background": "#26201A",
    "peekViewTitleDescription.foreground": "#C4A97D",
    "peekViewTitleLabel.foreground": "#F0A84C",

    // ── Diff Editor ─────────────────────────────────────────
    "diffEditor.insertedTextBackground": "#5C8A4A22",
    "diffEditor.removedTextBackground": "#E85A4F22",
    "diffEditor.insertedLineBackground": "#5C8A4A18",
    "diffEditor.removedLineBackground": "#E85A4F18",

    // ── Git Decorations ─────────────────────────────────────
    "gitDecoration.modifiedResourceForeground": "#F0A84C",
    "gitDecoration.deletedResourceForeground": "#E85A4F",
    "gitDecoration.untrackedResourceForeground": "#6AAF5C",
    "gitDecoration.conflictingResourceForeground": "#D4843E",
    "gitDecoration.ignoredResourceForeground": "#4A3E2A",

    // ── Scrollbar ───────────────────────────────────────────
    "scrollbar.shadow": "#0A0A08",
    "scrollbarSlider.background": "#3A2E2266",
    "scrollbarSlider.hoverBackground": "#4A3E2A88",
    "scrollbarSlider.activeBackground": "#5A4E3AAA",

    // ── Minimap ─────────────────────────────────────────────
    "minimap.background": "#1A1410",
    "minimapGutter.addedBackground": "#5C8A4A",
    "minimapGutter.modifiedBackground": "#F0A84C",
    "minimapGutter.deletedBackground": "#E85A4F",

    // ── Badge ───────────────────────────────────────────────
    "badge.background": "#D4843E",
    "badge.foreground": "#1A1410",

    // ── Breadcrumbs ─────────────────────────────────────────
    "breadcrumb.foreground": "#7A6A50",
    "breadcrumb.focusForeground": "#E8D5B7",
    "breadcrumb.activeSelectionForeground": "#F0A84C",

    // ── Widget (find/replace, etc.) ─────────────────────────
    "editorWidget.background": "#1E1812",
    "editorWidget.border": "#3A2E22",
    "editorWidget.foreground": "#E8D5B7",
    "editorSuggestWidget.selectedBackground": "#2E2419",

    // ── Notifications ───────────────────────────────────────
    "notifications.background": "#1E1812",
    "notifications.foreground": "#E8D5B7",
    "notifications.border": "#3A2E22",
    "notificationCenterHeader.background": "#26201A",

    // ── Debug ───────────────────────────────────────────────
    "debugToolBar.background": "#26201A",
    "debugIcon.breakpointForeground": "#E85A4F",
    "debugIcon.startForeground": "#6AAF5C",

    // ── Welcome page ────────────────────────────────────────
    "welcomePage.tileBackground": "#1E1812",
    "welcomePage.tileBorder": "#2E2419",
    "walkThrough.embeddedEditorBackground": "#1A1410",

    // ── Settings ────────────────────────────────────────────
    "settings.headerForeground": "#F0A84C",
    "settings.modifiedItemIndicator": "#D4843E",

    // ── Keybinding ──────────────────────────────────────────
    "keybindingLabel.background": "#26201A",
    "keybindingLabel.foreground": "#E8D5B7",
    "keybindingLabel.border": "#3A2E22",
    "keybindingLabel.bottomBorder": "#2E2419"
  },
  "tokenColors": [
    // ── Comments — muted sage, italic ───────────────────────
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6A7A52",
        "fontStyle": "italic"
      }
    },
    // ── Strings — warm bamboo green ─────────────────────────
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#8ACF7A"
      }
    },
    // ── String escape sequences ─────────────────────────────
    {
      "name": "Escape Characters",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#5C9A7A"
      }
    },
    // ── Numbers & constants — warm gold ─────────────────────
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F0C06C"
      }
    },
    // ── Booleans / null ─────────────────────────────────────
    {
      "name": "Boolean/Null",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#E8A060"
      }
    },
    // ── Keywords — bright tiki orange ───────────────────────
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D4843E"
      }
    },
    // ── Operators ───────────────────────────────────────────
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#C4A97D"
      }
    },
    // ── Functions — bright warm orange ──────────────────────
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#F0A84C"
      }
    },
    // ── Function parameters ─────────────────────────────────
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#D4D0B0",
        "fontStyle": "italic"
      }
    },
    // ── Variables — warm parchment ──────────────────────────
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8D5B7"
      }
    },
    // ── Properties ──────────────────────────────────────────
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C4BE96"
      }
    },
    // ── Types / Classes — leafy green ───────────────────────
    {
      "name": "Types and Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6AAF5C"
      }
    },
    // ── Interfaces / type parameters ────────────────────────
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#8AB87A",
        "fontStyle": "italic"
      }
    },
    // ── Decorators / Annotations ────────────────────────────
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D4943E"
      }
    },
    // ── Tags (HTML/JSX) — warm orange ───────────────────────
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D4843E"
      }
    },
    // ── Tag attributes ──────────────────────────────────────
    {
      "name": "Tag Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#F0A84C",
        "fontStyle": "italic"
      }
    },
    // ── Punctuation — subdued warm ──────────────────────────
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8A7A60"
      }
    },
    // ── Regex ───────────────────────────────────────────────
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "string.regexp keyword.operator"
      ],
      "settings": {
        "foreground": "#5C9A7A"
      }
    },
    // ── Markdown headings ───────────────────────────────────
    {
      "name": "Markdown Headings",
      "scope": [
        "heading.1.markdown entity.name",
        "heading.2.markdown entity.name",
        "heading.3.markdown entity.name",
        "heading.4.markdown entity.name",
        "heading.5.markdown entity.name",
        "heading.6.markdown entity.name",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#F0A84C",
        "fontStyle": "bold"
      }
    },
    // ── Markdown bold ───────────────────────────────────────
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#E8C56A",
        "fontStyle": "bold"
      }
    },
    // ── Markdown italic ─────────────────────────────────────
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#D4BE96",
        "fontStyle": "italic"
      }
    },
    // ── Markdown links ──────────────────────────────────────
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#5C9A7A"
      }
    },
    // ── Markdown code ───────────────────────────────────────
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#8ACF7A"
      }
    },
    // ── JSON keys ───────────────────────────────────────────
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#D4943E"
      }
    },
    // ── YAML keys ───────────────────────────────────────────
    {
      "name": "YAML Keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#D4943E"
      }
    },
    // ── CSS/SCSS selectors ──────────────────────────────────
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#F0A84C"
      }
    },
    // ── CSS properties ──────────────────────────────────────
    {
      "name": "CSS Properties",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#C4BE96"
      }
    },
    // ── CSS values ──────────────────────────────────────────
    {
      "name": "CSS Values",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#8ACF7A"
      }
    },
    // ── Terraform / HCL ─────────────────────────────────────
    {
      "name": "HCL Block Types",
      "scope": ["entity.name.type.terraform", "storage.type.hcl"],
      "settings": {
        "foreground": "#D4843E"
      }
    },
    {
      "name": "HCL Block Labels",
      "scope": ["entity.name.label.terraform", "variable.other.label.hcl"],
      "settings": {
        "foreground": "#F0A84C"
      }
    },
    // ── Shell / Bash ────────────────────────────────────────
    {
      "name": "Shell Variables",
      "scope": ["variable.other.normal.shell", "punctuation.definition.variable.shell"],
      "settings": {
        "foreground": "#E8C56A"
      }
    },
    // ── Invalid / Deprecated ────────────────────────────────
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#E85A4F",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#C47A3E",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#F0A84C",
    "function.declaration": "#F0A84C",
    "method": "#F0A84C",
    "variable": "#E8D5B7",
    "variable.readonly": "#E8C56A",
    "parameter": { "foreground": "#D4D0B0", "italic": true },
    "property": "#C4BE96",
    "type": "#6AAF5C",
    "class": "#6AAF5C",
    "interface": { "foreground": "#8AB87A", "italic": true },
    "enum": "#6AAF5C",
    "enumMember": "#F0C06C",
    "namespace": "#8AB87A",
    "decorator": "#D4943E",
    "string": "#8ACF7A",
    "number": "#F0C06C",
    "keyword": "#D4843E",
    "comment": { "foreground": "#6A7A52", "italic": true },
    "regexp": "#5C9A7A"
  }
}
